# X-Lance API (GraphQL)
# Адрес эндпоинта; если не задан — используется https://preview.x-lance.ru/api/graphql
VITE_XLANCE_API_URL=https://preview.x-lance.ru/api/graphql

# Заголовок приложения
VITE_APP_TITLE=X-Lance · Спаси конференцию!

# Режим отладки: true — под решением команды показывается отчёт об отправке
# в X-Lance (что ушло, что нет, «Повторить»). В проде — false.
VITE_DEBUG=false

# Авторизация выполняется в UI (email + пароль) через GraphQL signIn/signUp —
# статичный токен в .env больше не требуется. Токены хранятся в localStorage.

# Вход участников по ссылке (/join): приглашает служебный аккаунт — админ игровых тенантов.
# Без префикса VITE_ — читается только сервером (vite dev / preview), в бандл не попадает.
XL_JOIN_EMAIL=
XL_JOIN_PASSWORD=
# Куда открыт вход — настраивается в Админке (/admin) и хранится в этом файле на сервере
# XL_JOIN_STORE=.data/join-tenants.json
# Код роли тенанта для участника
XL_JOIN_ROLE=TENANT_MEMBER
