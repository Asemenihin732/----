# Базовый URL реального API X-Lance
VITE_XLANCE_API_URL=https://preview.x-lance.ru/api/graphql

# Заголовок приложения
VITE_APP_TITLE=X-Lance · Спаси конференцию!

# Режим отладки: true — отчёт об отправке решений в X-Lance под решением команды
VITE_DEBUG=false

# Ключи или id тенантов через запятую, куда можно войти по ссылке; пусто — вход закрыт
XL_JOIN_TENANTS=IG, IG1
# Код роли тенанта для участника
XL_JOIN_ROLE=TENANT_MEMBER
XL_JOIN_INVITE_TIME=24h
