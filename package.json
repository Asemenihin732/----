{
  "name": "xlance-spasi-konferenciyu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Деловая игра X-Lance «Спаси конференцию!» — веб-приложение фасилитатора и команд",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:server": "esbuild server/serve.ts --bundle --platform=node --format=esm --outfile=dist-server/serve.mjs --log-level=warning",
    "serve": "node dist-server/serve.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:data": "node scripts/check-data.cjs",
    "test:engine": "esbuild tests/engine.test.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=.tmp-test/engine.test.cjs --log-level=warning && node .tmp-test/engine.test.cjs",
    "test:smoke": "node scripts/smoke.cjs",
    "e2e:login": "playwright test --project=login",
    "e2e": "playwright test --project=finance",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json --noEmit",
    "provision": "esbuild scripts/provision-entry.ts --bundle --platform=node --format=esm --outfile=.tmp-test/provision.mjs --log-level=warning && node .tmp-test/provision.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^11.11.17",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "22.10.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
