{
  "compilerOptions": {
    "composite": true,
    "outDir": ".tmp-test/tsc-node",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "server",
    // серверный /api/join переиспользует GraphQL-клиент игры
    "src/api/graphql.ts",
    "src/api/authStore.ts",
    "src/api/graphqlApi.ts"
  ]
}
